  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dystopian.EnemyTest.NpcInteractable
  npcDisplayName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
  playerTarget: {fileID: 0}
  autoFindPlayerTarget: 1
  interactionRadius: 2.6
  verticalRange: 2.3
  useSideViewDistance: 1
  facePlayerWhenInRange: 1
  interactKey: 101
  canRepeatDialogue: 1
  promptRoot: {fileID: 3289990090893885888}
  promptText: {fileID: 5733423795764899164}
  promptFormat: "E : \uB300\uD654"
  keepPromptFacingCamera: 1
  dialogueBranches:
  - branchId: tutorial_step_2_repeat
    lines:
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uC9C0\uAE08 NPC \uC2DC\uC2A4\uD15C\uC740 \uB3C5\uB9BD \uD14C\uC2A4\uD2B8\uC6A9\uC73C\uB85C
        \uB3D9\uC791 \uC911\uC774\uC5D0\uC694."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uB2E4\uB978 \uD30C\uD2B8\uC5D0\uC11C\uB294 \uC774 NPC \uD504\uB9AC\uD339\uACFC
        DialogueManager\uB97C \uC52C\uC5D0 \uB450\uACE0, \uD544\uC694\uD55C \uC774\uBCA4\uD2B8\uB9CC
        UnityEvent\uB85C \uC5F0\uACB0\uD558\uBA74 \uB429\uB2C8\uB2E4."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    requiredFlagKey: 
    requiredFlagValue: 1
    minimumTutorialStep: 2
    maximumTutorialStep: -1
    flagKeyToSetOnComplete: 
    flagValueOnComplete: 1
    tutorialStepToSetOnComplete: -1
    advanceTutorialStepOnComplete: 0
    debugEventNameOnComplete: npc_tutorial_repeat
    onDialogueStarted:
      m_PersistentCalls:
        m_Calls: []
    onDialogueCompleted:
      m_PersistentCalls:
        m_Calls: []
  - branchId: tutorial_step_1_rhythm_hint
    lines:
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uC88B\uC544\uC694. \uB2E4\uC74C \uB2E8\uACC4\uB294 \uC870\uAC74\uBCC4
        \uB300\uD654\uC608\uC694."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uC774 \uB300\uD654\uB294 \uCCAB \uB300\uD654\uB97C \uB05D\uB0B8 \uB4A4\uC5D0\uB9CC
        \uB098\uC624\uACE0, \uC644\uB8CC\uB418\uBA74 \uD29C\uD1A0\uB9AC\uC5BC \uC9C4\uD589\uB3C4\uAC00
        2\uB85C \uC62C\uB77C\uAC11\uB2C8\uB2E4."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    requiredFlagKey: tutorial_npc_met
    requiredFlagValue: 1
    minimumTutorialStep: 1
    maximumTutorialStep: 1
    flagKeyToSetOnComplete: 
    flagValueOnComplete: 1
    tutorialStepToSetOnComplete: -1
    advanceTutorialStepOnComplete: 1
    debugEventNameOnComplete: npc_tutorial_step_1_completed
    onDialogueStarted:
      m_PersistentCalls:
        m_Calls: []
    onDialogueCompleted:
      m_PersistentCalls:
        m_Calls: []
  - branchId: first_talk
    lines:
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uC548\uB155\uD558\uC138\uC694. \uC800\uB294 NPC \uB300\uD654 \uD14C\uC2A4\uD2B8\uC6A9
        \uCE90\uB9AD\uD130\uC608\uC694."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uAC00\uAE4C\uC774 \uC624\uBA74 E \uD45C\uC2DC\uAC00 \uB728\uACE0, E\uB97C
        \uB204\uB974\uBA74 \uB300\uD654\uAC00 \uC2DC\uC791\uB429\uB2C8\uB2E4."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
    - speakerName: "\uD29C\uD1A0\uB9AC\uC5BC NPC"
      text: "\uB300\uD654 \uC911\uC5D0\uB294 \uD50C\uB808\uC774\uC5B4 \uC870\uC791\uC774
        \uC7A0\uAE30\uACE0, Space / Enter / E\uB85C \uB2E4\uC74C \uBB38\uC7A5\uC73C\uB85C
        \uB118\uAE38 \uC218 \uC788\uC5B4\uC694."
      onLineShown:
        m_PersistentCalls:
          m_Calls: []
      onLineCompleted:
        m_PersistentCalls:
          m_Calls: []
